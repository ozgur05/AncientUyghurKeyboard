// designer.rc — version info + shared DPI/manifest for the layout designer.
#include <windows.h>
#include "../AppVersion.hpp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    AUK_VER_MAJOR,AUK_VER_MINOR,AUK_VER_PATCH,0
 PRODUCTVERSION AUK_VER_MAJOR,AUK_VER_MINOR,AUK_VER_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Open Source"
            VALUE "FileDescription",  "Ancient Uyghur Layout Designer"
            VALUE "FileVersion",      AUK_APP_VERSION_STR
            VALUE "InternalName",     "AncientUyghurDesigner"
            VALUE "OriginalFilename", "AncientUyghurDesigner.exe"
            VALUE "ProductName",      "Ancient Uyghur Keyboard"
            VALUE "ProductVersion",   AUK_APP_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Reuse the main app's manifest (DPI awareness + common controls v6).
CREATEPROCESS_MANIFEST_RESOURCE RT_MANIFEST "app.manifest"
